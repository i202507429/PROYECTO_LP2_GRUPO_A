    <subDataset name="DatasetDetallePedido" uuid="2d3c4b5a-6f7e-4d8c-9b0a-1f2e3d4c5b6a">
        <parameter name="pNumPedido" class="java.lang.Integer"/>
        <queryString language="SQL">
            <![CDATA[
SELECT CONCAT(pz.nombre, ' (', t.descripcion, ')') AS descripcion,
       dp.cantidad AS cantidad,
       dp.subtotal AS subtotal
FROM tbl_detalle_pizza dp
JOIN tbl_pizza_tamanio pt ON dp.id_pizza_tamanio = pt.id_pizza_tamanio
JOIN tbl_pizza pz ON pt.id_pizza = pz.id_pizza
JOIN tbl_tamanio t ON pt.id_tamanio = t.id_tamanio
WHERE dp.id_pedido = $P{pNumPedido}
UNION ALL
SELECT a.descripcion AS descripcion,
       da.cantidad AS cantidad,
       da.subtotal AS subtotal
FROM tbl_detalle_adicional da
JOIN tbl_adicional a ON da.id_adicional = a.id_adicional
WHERE da.id_pedido = $P{pNumPedido}
            ]]>
        </queryString>
        <field name="descripcion" class="java.lang.String"/>
        <field name="cantidad" class="java.lang.Integer"/>
        <field name="subtotal" class="java.math.BigDecimal"/>
        <variable name="vTotal" class="java.math.BigDecimal" calculation="Sum">
            <variableExpression><![CDATA[$F{subtotal}]]></variableExpression>
        </variable>
    </subDataset>

    <parameter name="pNumPedido" class="java.lang.Integer"/>
    <parameter name="pLogo" class="java.lang.String"/>

    <queryString language="SQL">
        <![CDATA[
SELECT p.id_pedido,
       CONCAT('PEDIDO N° ', LPAD(p.id_pedido, 6, '0')) AS numPedText,
       COALESCE(p.nombre_cliente, 'Cliente Mostrador') AS nombreCliente,
       CONCAT(u.nombres, ' ', u.apellidos) AS nombreUsuario,
       DATE_FORMAT(p.fecha, '%d/%m/%Y %H:%i') AS fechaText,
       p.estado AS estado,
       COALESCE(p.metodo_pago, '-') AS metodoPago,
       p.total AS total
FROM tbl_pedido p
JOIN tbl_usuario u ON p.id_usuario = u.id_usuario
WHERE p.id_pedido = $P{pNumPedido}
        ]]>
    </queryString>

    <field name="id_pedido" class="java.lang.Integer"/>
    <field name="numPedText" class="java.lang.String"/>
    <field name="nombreCliente" class="java.lang.String"/>
    <field name="nombreUsuario" class="java.lang.String"/>
    <field name="fechaText" class="java.lang.String"/>
    <field name="estado" class="java.lang.String"/>
    <field name="metodoPago" class="java.lang.String"/>
    <field name="total" class="java.math.BigDecimal"/>

